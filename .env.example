# Supabase Configuration (Configure these in AI Studio Secrets)
# Frontend-safe keys (used by browser via /api/public-config)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"

# Server-only secret (NEVER expose to browser or client bundle)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
